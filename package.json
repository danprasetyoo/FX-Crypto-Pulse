{
  "name": "fx-crypto-pulse",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard kurs mata uang dan harga kripto dengan grafik historis, konverter, watchlist, dan alert harga via email.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "build:shared": "npm run build -w packages/shared",
    "build": "npm run build:shared && npm run build --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "test": "npm run build:shared && npm run test --workspaces --if-present",
    "test:unit": "npm run test",
    "e2e": "npm run test -w e2e",
    "e2e:ui": "npm run test:ui -w e2e",
    "stack:up": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml up -d --build --wait",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml down -v",
    "stack:logs": "docker compose -f docker-compose.yml -f docker-compose.e2e.yml logs -f",
    "dev:up": "docker compose up -d --build --wait",
    "dev:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
