{
  "name": "@fxpulse/market-service",
  "version": "1.0.0",
  "private": true,
  "description": "Proxy + cache ke Frankfurter dan CoinGecko. Endpoint /api/fx, /api/crypto, /api/convert.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "tsc -w -p tsconfig.build.json & node --watch dist/main.js",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@fxpulse/shared": "1.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "ioredis": "^5.8.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.9",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
