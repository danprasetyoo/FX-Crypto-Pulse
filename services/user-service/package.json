{
  "name": "@fxpulse/user-service",
  "version": "1.0.0",
  "private": true,
  "description": "Auth, watchlist, dan alert per akun. Endpoint /api/auth, /api/watchlist, /api/alerts. Pemilik skema PostgreSQL.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "@fxpulse/shared": "1.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
