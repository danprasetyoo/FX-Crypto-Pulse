{
  "name": "@fxpulse/alert-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Worker BullMQ: tiap 5 menit ambil harga dari market-service, cocokkan dengan alert aktif di PostgreSQL, kirim email tepat sekali.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fxpulse/shared": "1.0.0",
    "bullmq": "^5.61.0",
    "ioredis": "^5.8.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.9",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
