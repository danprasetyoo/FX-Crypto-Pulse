# Salin ke .env lalu sesuaikan. JANGAN commit file .env.
# Semua nilai di bawah adalah default untuk docker compose lokal.

# ---- Umum ----
NODE_ENV=development
LOG_LEVEL=info
# URL publik aplikasi (dipakai untuk link di email reset password)
APP_BASE_URL=http://localhost:8080
# Port gateway nginx di host
GATEWAY_PORT=8080

# ---- Infrastruktur ----
POSTGRES_USER=fxpulse
POSTGRES_PASSWORD=fxpulse
POSTGRES_DB=fxpulse
DATABASE_URL=postgres://fxpulse:fxpulse@postgres:5432/fxpulse
REDIS_URL=redis://redis:6379

# ---- market-service (proxy ke API eksternal) ----
# Frankfurter (kurs referensi ECB). Tidak butuh API key.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v1
# CoinGecko free tier. API key opsional (demo key dikirim sebagai header x-cg-demo-api-key).
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
# Timeout upstream (ms) dan jumlah retry untuk timeout/5xx. 429 tidak pernah di-retry.
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_MAX_RETRIES=2
# TTL cache (detik). Default mengikuti PRD: harga 60 dtk, histori 1 jam, kurs 1 jam.
CACHE_TTL_CRYPTO_TOP_SEC=60
CACHE_TTL_CRYPTO_HISTORY_SEC=3600
CACHE_TTL_FX_SEC=3600
# Endpoint admin (flush cache) hanya untuk e2e/staging. Jangan aktifkan di produksi.
MARKET_ADMIN_ENABLED=false

# ---- user-service (auth, watchlist, alert) ----
# Ganti dengan string acak minimal 32 karakter di produksi.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
# true jika aplikasi diakses lewat HTTPS
COOKIE_SECURE=false

# ---- Email (alert dan reset password) ----
# Dev: Mailpit di docker compose (UI http://localhost:8025)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FX & Crypto Pulse <no-reply@fxpulse.local>"

# ---- alert-worker ----
# Interval evaluasi alert (ms). PRD: 5 menit.
ALERT_INTERVAL_MS=300000
# Jalankan evaluasi pertama segera setelah worker start
ALERT_RUN_ON_START=true
# Endpoint admin worker (POST /run) hanya untuk e2e. Jangan aktifkan di produksi.
WORKER_ADMIN_ENABLED=false

# ---- Image registry (dipakai docker compose saat deploy) ----
IMAGE_PREFIX=ghcr.io/your-org/fx-crypto-pulse
IMAGE_TAG=latest
